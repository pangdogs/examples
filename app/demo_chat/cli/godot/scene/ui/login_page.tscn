[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://script/ui/login_page.gd" id="1_login"]

[node name="LoginPage" type="MarginContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32
script = ExtResource("1_login")

[node name="LoginCenter" type="CenterContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="LoginPanel" type="PanelContainer" parent="LoginCenter" unique_name_in_owner=true]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="LoginCenter/LoginPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Body" type="VBoxContainer" parent="LoginCenter/LoginPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="LoginTitle" type="Label" parent="LoginCenter/LoginPanel/Margin/Body" unique_name_in_owner=true]
layout_mode = 2
text = "Lightship Demo Chat"
horizontal_alignment = 1

[node name="LoginSubtitle" type="Label" parent="LoginCenter/LoginPanel/Margin/Body" unique_name_in_owner=true]
layout_mode = 2
text = "GTP RPC CONNECT"
horizontal_alignment = 1

[node name="LoginGrid" type="GridContainer" parent="LoginCenter/LoginPanel/Margin/Body"]
layout_mode = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 12
