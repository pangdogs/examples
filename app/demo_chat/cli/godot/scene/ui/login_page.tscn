layout_mode = 2
text = "ws://localhost:8080"
placeholder_text = "ws://localhost:8080"
clear_button_enabled = true

[node name="ProtocolField" type="VBoxContainer" parent="LoginCenter/LoginPanel/Margin/Body/LoginGrid"]
